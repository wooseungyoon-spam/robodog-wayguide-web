# ==========================================
# RoboDog WAY GUIDE - Environment Configuration
# ==========================================

# 서버 기본 설정
HOST=0.0.0.0
PORT=5000
DEBUG=True

# [중요] 네이버 지도 Web Dynamic Map Client ID
# 네이버 클라우드 플랫폼(https://www.ncloud.com) -> 콘솔 -> AI·NAVER API -> Maps에서 발급받은 Client ID를 입력하세요.
# 키를 입력하지 않아도 기본 시뮬레이터로 작동하며, 입력 시 실제 네이버 지도가 화면에 나타납니다.
NAVER_MAP_CLIENT_ID=your_naver_client_id_here

# 카카오 맵 JavaScript 키 (선택 사항)
KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here

# 경찰청·도로교통공단 UTIC 실시간 신호등 C-ITS API 키
UTIC_API_KEY=your_utic_api_key_here

# 시연 및 테스트용 가상 시뮬레이터 활성화 플래그
USE_MOCK_SIGNAL=true
USE_MOCK_ROUTE=true
USE_MOCK_BLE=false
